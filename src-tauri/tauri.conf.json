{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FamilyLightbox",
  "version": "0.1.0",
  "identifier": "io.atomicbits.familylightbox",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FamilyLightbox",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' preview: http://preview.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Atomic Bits",
    "copyright": "Copyright (c) 2026 Atomic Bits",
    "category": "Photography",
    "shortDescription": "Browse and select photos in the family photo library",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
