{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FamilyLightbox",
  "version": "0.3.0",
  "identifier": "io.atomicbits.familylightbox",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "title": "FamilyLightbox",
        "visible": false,
        "center": true,
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' preview: http://preview.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "Atomic Bits",
    "copyright": "Copyright (c) 2026 Atomic Bits",
    "category": "Photography",
    "shortDescription": "Browse and select photos in the family photo library",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1MkU2OTJGMTYyM0NGNEUKUldST3p5TVdMMmt1UmIyVzZYdUxvT0xleFdzd3l1cTdjaXNYbXhkQjNKVzZML1ZmdjBuc2pqdngK",
      "endpoints": ["https://github.com/atomicbits/family-lightbox/releases/latest/download/latest.json"]
    }
  }
}
